# feishu-clipper 配置文件
# 复制此文件到 ~/.qoder-cn/skills/feishu-clipper/config.yaml 并修改

# 默认保存的知识库名称（用户 prompt 中可覆盖）
default_wiki_space: "Area"

# 代理设置（用于抓取外网内容）
proxy: "http://127.0.0.1:7890"

# 阅读笔记语言
notes_language: "zh"

# 文档结构
sections:
  - title: "阅读笔记"
    position: "top"
  - title: "原文"
    position: "bottom"
